// Codespaces setup for the Shoreline Flask backend.
// On create: install requirements and set up the database. On every start: run Flask
// (gunicorn) on port 8587 in the background; logs go to flask.log.
// The site reaches it at https://<codespace-name>-8587.app.github.dev (port must be Public).
{
  "name": "Shoreline Flask",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8587],
  "portsAttributes": {
    "8587": { "label": "Shoreline Flask", "onAutoForward": "silent" }
  },
  "postCreateCommand": "pip install --user -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-flask.sh",
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
