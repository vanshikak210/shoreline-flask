# Copy to .env on the server (cp .env.example .env) and fill in the blanks.
# .env is git-ignored: never commit real passwords.

# Production mode: secure cross-site login cookie (needs HTTPS via certbot).
IS_PRODUCTION=true

# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Passwords for the seeded admin / teacher / default users (change these!).
ADMIN_UID=admin
ADMIN_PASSWORD=
DEFAULT_PASSWORD=

# Faster logins on a small server (password hashing rounds).
PASSWORD_HASH_ITERATIONS=200000

# Docker always serves on 8550 (gunicorn bind in Dockerfile); this just labels it.
FLASK_PORT=8550

# Extra frontend origins allowed by CORS, comma-separated (your new frontend domain).
EXTRA_CORS_ORIGINS=
